# Copy to backend/.env. Never put secrets in NEXT_PUBLIC_ variables.
LLM_BASE_URL=https://api.openai.com/v1
# Alternative: Groq uses https://api.groq.com/openai/v1
# Choose ONE provider endpoint and its matching key/model. See docs/api-options.md.
LLM_API_KEY=
# Set a model available to your provider/account; no model is silently selected.
LLM_MODEL=
# json_object for compatible providers; json_schema if your model supports strict schemas.
LLM_RESPONSE_FORMAT=json_object
REQUEST_TIMEOUT_SECONDS=60
DATABASE_PATH=data/reviewmind.db
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional shared access token. Leave empty only for local development.
API_TOKEN=
# Provision this bank in your Hindsight instance before enabling memory.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=reviewmind-local
# Single authorized project for this first milestone; clients cannot choose a bank.
PROJECT_ID=demo-repository
